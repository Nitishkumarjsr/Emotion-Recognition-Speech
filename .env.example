# ============================================================================
# VoxEmotion AI - Environment Configuration Variables
# ============================================================================

# Backend Port (Defaults to 5002 locally, Render automatically sets $PORT)
PORT=5002

# Allowed CORS Origins (Use * for all, or comma-separated Vercel domains)
# Example: https://voxemotion.vercel.app,http://localhost:3000,http://127.0.0.1:5500
CORS_ORIGINS=*

# Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key or Service Role Key
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Optional: Environment flag (production / development)
ENV=production
